			visible		1
			action
			{
				play	"sound/interface/button1.wav" ;
				exec	"coop_difficulty 1" ;
				hide	diff_apprentice_frame ;
				show	diff_jedi_frame ;
				hide	diff_knight_frame ;
				hide	diff_master_frame
			}
		}

