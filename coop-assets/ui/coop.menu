		itemDef
		{
			name		diff_apprentice
			text		"PADAWAN"
			descText	"Padawan difficulty"
			type		ITEM_TYPE_BUTTON
			style		WINDOW_STYLE_EMPTY
			rect		145 293 85 24
			font		3
			textscale	0.7
			textalign	ITEM_ALIGN_CENTER
			textalignx	42
			textaligny	2
			forecolor	0.65 0.65 1 1
			visible		1
			action
			{
				play	"sound/interface/button1.wav" ;
				exec	"coop_difficulty 0" ;
				show	diff_apprentice_frame ;
				hide	diff_jedi_frame ;
				hide	diff_knight_frame ;
				hide	diff_master_frame
			}
		}

		itemDef
		{
			name		diff_jedi
			text		"JEDI"
			descText	"Jedi difficulty"
			type		ITEM_TYPE_BUTTON
