// Steam co-op setup menu.
{
	menuDef
	{
		name			"coopMenu"
		fullScreen		1
		rect			0 0 640 480
		visible			1
		focusColor		1 1 1 1
		descX			375
		descY			425
		descScale		.8
		descColor		.235 .882 .847 1
		descAlignment	ITEM_ALIGN_CENTER

		onOpen
		{
			setfocus coopinvitebutton
		}

		onESC
		{
			play	"sound/interface/button1.wav" ;
			close	all ;
			open	mainMenu
		}

		itemDef
		{
			name		frame_pic
